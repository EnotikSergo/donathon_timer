{
  "name": "donathon-countdown",
  "version": "2.0.0",
  "description": "Таймер донатона для стрима с DonationAlerts и DonateX",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "start:forge": "electron-forge start",
    "test": "node --test \"test/*.test.js\"",
    "lint": "eslint .",
    "package": "electron-forge package",
    "make": "electron-forge make"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EnotikSergo/donathon_timer"
  },
  "author": "Kozjar, EnotikSergo",
  "license": "ISC",
  "bugs": {
    "url": "https://github.com/EnotikSergo/donathon_timer"
  },
  "homepage": "https://github.com/EnotikSergo/donathon_timer",
  "engines": {
    "node": ">=22.13.0"
  },
  "devDependencies": {
    "@electron-forge/cli": "8.0.1",
    "@electron-forge/maker-deb": "8.0.1",
    "@electron-forge/maker-rpm": "8.0.1",
    "@electron-forge/maker-squirrel": "8.0.1",
    "@electron-forge/maker-zip": "8.0.1",
    "@eslint/js": "9.39.5",
    "electron": "45.3.0",
    "eslint": "9.39.5",
    "globals": "17.14.0"
  },
  "config": {
    "forge": {
      "packagerConfig": {
        "ignore": [
          "^/test($|/)",
          "^/guide($|/)",
          "^/saves($|/)",
          "^/\\.github($|/)",
          "^/\\.idea($|/)",
          "^/README\\.md$",
          "^/eslint\\.config\\.js$",
          "^/\\.gitignore$"
        ]
      },
      "makers": [
        {
          "name": "@electron-forge/maker-squirrel",
          "config": {
            "name": "donathon_timer"
          }
        },
        {
          "name": "@electron-forge/maker-zip",
          "platforms": [
            "darwin"
          ]
        },
        {
          "name": "@electron-forge/maker-deb",
          "config": {}
        },
        {
          "name": "@electron-forge/maker-rpm",
          "config": {}
        }
      ]
    }
  }
}
